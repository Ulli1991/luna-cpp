# Writes luna_build_info.cpp (luna::build_info(), src/hydro/build_info.hpp) and luna_build_info.txt into OUT_DIR:
# the commits and dirty flags of luna-cpp and voronoi-cpp. Runs at configure and at every build (cmake -P), and
# rewrites the files only when they change, so a commit relinks the programs without recompiling them.
# Needs LUNA_SOURCE_DIR, VORONOI_DIR, VORONOI_ORIGIN, OUT_DIR.
function(luna_commit dir sha_var dirty_var)
    execute_process(COMMAND git -C "${dir}" rev-parse HEAD OUTPUT_VARIABLE sha
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE status)
    if(NOT status EQUAL 0 OR sha STREQUAL "")
        set(sha "unknown")
    endif()
    execute_process(COMMAND git -C "${dir}" status --porcelain --untracked-files=no OUTPUT_VARIABLE changes ERROR_QUIET)
    set(dirty 0)
    if(NOT changes STREQUAL "")
        set(dirty 1)
    endif()
    set(${sha_var} "${sha}" PARENT_SCOPE)
    set(${dirty_var} ${dirty} PARENT_SCOPE)
endfunction()

luna_commit("${LUNA_SOURCE_DIR}" luna_sha luna_dirty)
luna_commit("${VORONOI_DIR}" voronoi_sha voronoi_dirty)
set(line "build: luna-cpp=${luna_sha} luna_dirty=${luna_dirty} voronoi-cpp=${voronoi_sha} voronoi_dirty=${voronoi_dirty} voronoi_origin=${VORONOI_ORIGIN}")
set(cpp "// Generated by cmake/build_info.cmake; do not edit.\n#include \"build_info.hpp\"\n\nnamespace luna {\n\n"
        "BuildInfo build_info() { return {\"${luna_sha}\", ${luna_dirty}, \"${voronoi_sha}\", ${voronoi_dirty}, \"${VORONOI_ORIGIN}\"}; }\n\n"
        "}  // namespace luna\n")
function(luna_write name text)
    set(old "")
    if(EXISTS "${OUT_DIR}/${name}")
        file(READ "${OUT_DIR}/${name}" old)
    endif()
    if(NOT old STREQUAL text)
        file(WRITE "${OUT_DIR}/${name}" "${text}")
    endif()
endfunction()
luna_write(luna_build_info.cpp "${cpp}")
luna_write(luna_build_info.txt "${line}\n")
